APP_ENV=development
PGHOST=localhost
PGPORT=5555
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=auth
PGSSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONNECT_TIMEOUT=10s
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=authnode
JWT_AUDIENCE=authnode-api
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h
OTP_PEPPER=replace-with-a-different-32-character-secret
OTP_EXPIRATION=10m
OTP_RESEND_DELAY=1m
OTP_MAX_ATTEMPTS=5
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@authnode.local
HTTP_SERVER_ADDRESS=0.0.0.0:8000
SHUTDOWN_TIMEOUT=10s
